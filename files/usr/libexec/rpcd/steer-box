#!/bin/sh
# rpcd: страница Services → Steer Connector (luci-app-steer-box-connector).
#
#   status    что показывает sing-box (вариант, версия), служба, steer-core и модули: стоит ли,
#             какая версия, нужен ли текущему конфигу (sing-box box-needs);
#   releases  версии steer: из перечня выпусков splify2/releases (version.json), а если он не
#             ответил — из выпусков GitHub (splify2/steer);
#   install   поставить выбранной версии steer-core и модули (по умолчанию — те, что нужны).
#
# Пакеты ставятся с выпусков steer, как у splify2: их нет в feeds OpenWrt. Адреса и sha256 файлов —
# из перечня выпусков, затем прежняя ссылка выпуска steer.

# Швы для стенда (tests/releases.sh): на роутере rpcd запускает объект с чистым окружением, и
# берутся системные пути.
. "${JSHN_SH:-/usr/share/libubox/jshn.sh}"
OPENWRT_RELEASE=${OPENWRT_RELEASE:-/etc/openwrt_release}
SING_BOX=${SING_BOX:-/usr/bin/sing-box}

REPO=splify2/steer
# Перечень выпусков splify2/releases — три адреса одного version.json, по порядку. Он ПЕРВЫЙ
# источник версий и адресов файлов; api.github.com и прямая ссылка выпуска — запасной путь.
REL_URLS="https://raw.githubusercontent.com/splify2/releases/main/version.json https://cdn.jsdelivr.net/gh/splify2/releases@main/version.json https://splify2.github.io/releases/version.json"
REL=/tmp/steer-box-version.json
# Продукты steer и коннектора в перечне.
RP="@.products['steer'].versions"
RP_BOX="@.products['steer-box-connector'].versions"
# Пакеты steer, которые бывают у коннектора (status и смена версии).
MODS="steer-core steer-vless steer-hysteria2 steer-proxy steer-xsteer steer-obfs steer-tgws"
CONF=$(uci -q get sing-box.main.conffile)
[ -n "$CONF" ] || CONF=/etc/sing-box/config.json

pkg_ext() { command -v apk >/dev/null 2>&1 && echo apk || echo ipk; }

pkg_arch() {
	# Архитектура пакетов OpenWrt (aarch64_cortex-a53), а не машины: `apk --print-arch` на 25.12
	# отвечает aarch64, а пакеты steer названы по DISTRIB_ARCH.
	local DISTRIB_ARCH=""
	[ -f "$OPENWRT_RELEASE" ] && . "$OPENWRT_RELEASE"
	if [ -n "$DISTRIB_ARCH" ]; then
		echo "$DISTRIB_ARCH"
	elif command -v apk >/dev/null 2>&1; then
		apk --print-arch 2>/dev/null
	else
		opkg print-architecture 2>/dev/null | awk '$1=="arch" && $2!="all" && $2!="noarch" {a=$2} END {print a}'
	fi
}

pkg_version() {
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$1" >/dev/null 2>&1 || return 0
		apk list -I "$1" 2>/dev/null | awk -v p="$1" '{ v=$1; sub("^" p "-", "", v); sub("-r[0-9]+$", "", v); print v; exit }'
	else
		opkg status "$1" 2>/dev/null | awk '/^Version:/ { v=$2; sub("-[0-9]+$", "", v); print v }'
	fi
}

# Закрепления в /etc/apk/world, которые ни на что не указывают.
#
# `apk add ФАЙЛ` (apk 3) записывает в world не «имя», а «имя><хеш файла» — закрепление за этой
# сборкой. Если транзакция оборвалась на середине (на роутере с малым флешем — «No space left on
# device» при распаковке второго пакета набора), world уже записан с хешами НОВЫХ файлов, а в базе
# остались прежние пакеты или не появилось вовсе нового. С этой минуты ЛЮБАЯ команда apk — и наша,
# и чужая, хоть установка zapret — не решается: «unable to select packages: breaks:
# world[steer-core><Q1…]». Воспроизведено на apk 3.0.5 (как на OpenWrt 25.12.5) с tmpfs на 4–5 МБ.
#
# Чиним правкой самого файла, без apk: решатель в таком состоянии отказывает и на `apk add имя`.
# Что делаем с каждой записью «имя><хеш»:
#   - пакета с таким именем нет в базе — запись убирается: она ничего не держит;
#   - пакет стоит, но с другим хешом — становится просто «имя»;
#   - наше имя (аргумент — регулярное выражение имён) — становится «имя» всегда: закрепление за
#     файлом нужно только самой транзакции, дальше оно лишь не даёт apk увидеть пакет в фиде и
#     ломает следующую установку той же версии другой сборки.
# Записи без «><» (в том числе `!имя`) и закрепления чужих пакетов с верным хешом не трогаются.
# Пути — APK_WORLD и APK_DB: стенды подставляют свои.
PKG_OURS='^(steer|steer-.*|libsteer.*|steer-box-connector|luci-app-steer-box-connector)$'
pkg_world_heal() {  # [ИМЕНА-ERE]
	command -v apk >/dev/null 2>&1 || return 0
	_wh_w="${APK_WORLD:-/etc/apk/world}"; _wh_d="${APK_DB:-/lib/apk/db/installed}"
	[ -s "$_wh_w" ] && [ -s "$_wh_d" ] || return 0
	grep -q '><' "$_wh_w" 2>/dev/null || return 0
	grep -q '^P:' "$_wh_d" 2>/dev/null || return 0
	_wh_t="$_wh_w.heal.$$"
	if awk -v ours="${1:-^$}" '
		FILENAME == ARGV[1] {
			if ($0 ~ /^C:/) { c = substr($0, 3); if (p != "") id[p] = c }
			else if ($0 ~ /^P:/) { p = substr($0, 3); if (c != "") id[p] = c }
			if ($0 == "") { c = ""; p = "" }
			next
		}
		{
			i = index($0, "><")
			if (i == 0) { print; next }
			n = substr($0, 1, i - 1); q = substr($0, i + 2)
			if (!(n in id)) next
			if (n ~ ours || id[n] != q) print n; else print
		}' "$_wh_d" "$_wh_w" > "$_wh_t" 2>/dev/null; then
		cmp -s "$_wh_t" "$_wh_w" || mv "$_wh_t" "$_wh_w"
	fi
	rm -f "$_wh_t"
	return 0
}

fetch() {  # URL ФАЙЛ [СЕКУНД]
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL -m "${3:-120}" -o "$2" "$1"
	else
		wget -q -T "${3:-120}" -O "$2" "$1"
	fi
}

# version.json — с первого ответившего адреса, если его схема та, под которую написан разбор.
# Срок на адрес — 20 секунд, а не 120, как у пакетов: файл в десятки килобайт, а там, где адрес
# закрыт молча, три адреса по две минуты держали бы страницу шесть минут до запасного пути.
rel_load() {
	rm -f "$REL"
	for u in $REL_URLS; do
		if fetch "$u" "$REL" 20 && [ "$(jsonfilter -i "$REL" -e '@.schema' 2>/dev/null)" = 1 ]; then
			return 0
		fi
		rm -f "$REL"
	done
	return 1
}

# Индекс строки $2 в выводе jsonfilter по выражению $1 (с нуля); нет — код 1.
rel_index() {  # ВЫРАЖЕНИЕ ЗНАЧЕНИЕ
	_i=0
	while IFS= read -r _x; do
		[ "$_x" = "$2" ] && { echo "$_i"; return 0; }
		_i=$((_i + 1))
	done <<EOF
$(jsonfilter -i "$REL" -e "$1" 2>/dev/null)
EOF
	return 1
}

# Файл выпуска по перечню: sha256 — в SUM, адреса по порядку — в URLS. Имя файла собирается как
# прежде, и ищется по значению: имена 1.5.x (steer, steer-extended) и 2.0 (steer-core и модули)
# лежат в перечне как есть. Адрес — только https, из безопасных знаков и с именем файла на конце.
rel_asset() {  # ВЕРСИЯ ИМЯ_ФАЙЛА
	SUM=""; URLS=""
	[ -s "$REL" ] || return 1
	vi=$(rel_index "$RP[*].version" "$1") || return 1
	ai=$(rel_index "$RP[$vi].assets[*].name" "$2") || return 1
	while IFS= read -r x; do
		case "$x" in
		https://*[!A-Za-z0-9._~:/%+@=-]*) ;;
		https://?*/"$2") URLS="$URLS $x" ;;
		*[!0-9a-f]*) ;;
		*) [ "${#x}" = 64 ] && SUM="$x" ;;
		esac
	done <<EOF
$(jsonfilter -i "$REL" -e "$RP[$vi].assets[$ai].sha256" -e "$RP[$vi].assets[$ai].urls[*]" 2>/dev/null)
EOF
}

# Сверка с sha256 из перечня. Суммы нет — файл берётся без проверки (NOSUM=1, об этом скажет вывод);
# сумма есть, а sha256sum нет — отказ (NOTOOL=1): непроверенное не ставится. SHA256SUM — шов стенда.
SHA256SUM=${SHA256SUM:-sha256sum}
NOSUM=0; NOTOOL=0
sum_ok() {  # ФАЙЛ SHA256
	[ -n "$2" ] || { NOSUM=1; return 0; }
	command -v "$SHA256SUM" >/dev/null 2>&1 || { NOTOOL=1; return 1; }
	[ "$("$SHA256SUM" "$1" 2>/dev/null | cut -d' ' -f1)" = "$2" ]
}

# Пакет: адреса из перечня по порядку (сумма не сошлась — следующий), затем прежняя ссылка выпуска
# steer (у коннектора — его выпуска), если её не было среди них. Сумма сверяется у файла с любого
# адреса. RP и REPO — продукт: steer или сам коннектор.
pkg_fetch() {  # ВЕРСИЯ ИМЯ_ФАЙЛА ФАЙЛ [РЕПОЗИТОРИЙ]
	rel_asset "$1" "$2"
	old="https://github.com/${4:-$REPO}/releases/download/v$1/$2"
	case " $URLS " in *" $old "*) ;; *) URLS="$URLS $old" ;; esac
	for u in $URLS; do
		if fetch "$u" "$3" && sum_ok "$3" "$SUM"; then
			return 0
		fi
		rm -f "$3"
	done
	return 1
}

case "$1" in
list)
	echo '{ "status": {}, "releases": {}, "install": { "version": "", "packages": [] } }'
	;;
call)
	case "$2" in
	status)
		json_init
		ver_line=$("$SING_BOX" version 2>/dev/null | head -n1)
		json_add_string sing_box "${ver_line#sing-box version }"
		json_add_string variant "$(uci -q get steer-box.main.variant)"
		json_add_string version "$(uci -q get steer-box.main.version)"
		running=0
		pgrep -f '^/usr/bin/sing-box ' >/dev/null 2>&1 && running=1
		json_add_boolean running "$running"
		json_add_string arch "$(pkg_arch)"
		# Самая старая версия steer, с которой работает этот коннектор (его пакет зависит от
		# steer-core той же версии).
		json_add_string steer_min "$("$SING_BOX" version 2>/dev/null | sed -n 's/.*steer-box-connector \([0-9.]*\).*/\1/p' | head -n1)"
		needs=$("$SING_BOX" -c "$CONF" box-needs 2>/dev/null)
		json_add_array packages
		for p in $MODS; do
			json_add_object
			json_add_string name "$p"
			json_add_string installed "$(pkg_version "$p")"
			case "$needs" in *"\"$p\""*) json_add_boolean needed 1 ;; *) json_add_boolean needed 0 ;; esac
			json_close_object
		done
		json_close_array
		json_dump
		;;
	releases)
		json_init
		tmp=/tmp/steer-box-releases.json
		json_add_array versions
		n=0; pre=""; listed=" "
		# Перечень выпусков: versions[] по порядку (до десяти стабильных и текущая предварительная),
		# только цифры и точки — то, что примет install; предварительная — по полю prerelease.
		if rel_load; then
			for v in $(jsonfilter -i "$REL" -e "$RP[*].version" 2>/dev/null); do
				case "$v" in ''|*[!0-9.]*) continue ;; esac
				json_add_string "" "$v"
				listed="$listed$v "
				n=$((n + 1))
			done
			[ "$n" = 0 ] || pre=$(jsonfilter -i "$REL" -e "@.products['steer'].prerelease" 2>/dev/null)
			case "$listed" in *" $pre "*) ;; *) pre="" ;; esac
			rm -f "$REL"
		fi
		# Перечень не ответил или steer в нём нет — выпуски GitHub, как прежде.
		if [ "$n" = 0 ] && fetch "https://api.github.com/repos/$REPO/releases?per_page=10" "$tmp"; then
			for t in $(jsonfilter -i "$tmp" -e '@[*].tag_name' 2>/dev/null); do
				json_add_string "" "${t#v}"
			done
		fi
		json_close_array
		case "$pre" in ''|*[!0-9.]*) ;; *) json_add_string prerelease "$pre" ;; esac
		rm -f "$tmp"
		json_dump
		;;
	install)
		read -r input
		ver=$(jsonfilter -s "$input" -e '@.version' 2>/dev/null)
		pkgs=$(jsonfilter -s "$input" -e '@.packages[*]' 2>/dev/null)
		json_init
		case "$ver" in
		''|*[!0-9.]*) json_add_boolean ok 0; json_add_string error "в версии допустимы только цифры и точки"; json_dump; exit 0 ;;
		esac
		if [ -z "$pkgs" ]; then
			pkgs=$("$SING_BOX" -c "$CONF" box-needs 2>/dev/null | jsonfilter -e '@[*]')
			[ -n "$pkgs" ] || pkgs=steer-core
		fi
		# Пакеты steer и коннектор зависят друг от друга с точной версией (steer-core = версия).
		# Другая версия ставится только вся разом: каждый стоящий пакет steer этой же версией (иначе
		# менеджер пакетов откажет всей транзакции или, opkg, оставит модуль старой версии при новом
		# ядре) и коннектор той же версии — с его выпуска.
		cur=$("$SING_BOX" version 2>/dev/null | sed -n 's/.*steer-box-connector \([0-9.]*\).*/\1/p' | head -n1)
		box=0
		if [ "$ver" != "$cur" ]; then
			for p in $MODS; do
				[ -n "$(pkg_version "$p")" ] && pkgs="$pkgs $p"
			done
			box=1
		fi
		arch=$(pkg_arch); ext=$(pkg_ext)
		files=""; seen=" "
		rel_load
		for p in $pkgs; do
			case "$p" in steer-box-connector) continue ;; steer-*) ;; *) continue ;; esac
			# Имя идёт в путь файла в /tmp и в адрес: только знаки имён пакетов, без «/» и «..».
			case "$p" in *[!a-z0-9-]*) continue ;; esac
			case "$seen" in *" $p "*) continue ;; esac
			seen="$seen$p "
			f="/tmp/$p-$ver-1_$arch.$ext"
			if ! pkg_fetch "$ver" "$p-$ver-1_$arch.$ext" "$f"; then
				rm -f $files "$f" "$REL"
				json_add_boolean ok 0
				json_add_string error "не скачалось: $p $ver для $arch$([ "$NOTOOL" = 1 ] && echo " (нет sha256sum — сумму сверить нечем)")"
				json_dump; exit 0
			fi
			files="$files $f"
		done
		if [ "$box" = 1 ]; then
			p=steer-box-connector
			f="/tmp/$p-$ver-1_$arch.$ext"
			RP="$RP_BOX"
			if ! pkg_fetch "$ver" "$p-$ver-1_$arch.$ext" "$f" splify2/steer-box-connector; then
				rm -f $files "$f" "$REL"
				json_add_boolean ok 0
				json_add_string error "нет выпуска steer-box-connector $ver для $arch$([ "$NOTOOL" = 1 ] && echo " (нет sha256sum — сумму сверить нечем)")"
				json_dump; exit 0
			fi
			files="$files $f"
		fi
		rm -f "$REL"
		if [ "$ext" = apk ]; then
			# До и после (при любом исходе): оборванная установка оставляет в world закрепления за
			# файлами, которых в базе нет, и после неё не ставится ничто — см. pkg_world_heal.
			pkg_world_heal
			out=$(apk add --allow-untrusted $files 2>&1)
			rc=$?
			pkg_world_heal "$PKG_OURS"
		else
			out=$(opkg install --force-reinstall $files 2>&1)
			rc=$?
		fi
		[ "$NOSUM" = 1 ] && out="без проверки суммы: для части файлов суммы в перечне нет
$out"
		rm -f $files
		# Свой steerd у коннектора: служба steer без спеки ему мешает (те же таблицы).
		if [ -x /etc/init.d/steer ] && [ ! -f /etc/steer/spec.json ] && [ ! -f /etc/steer/spec.yaml ]; then
			/etc/init.d/steer stop >/dev/null 2>&1
			/etc/init.d/steer disable >/dev/null 2>&1
		fi
		[ "$rc" = 0 ] && pgrep -f '^/usr/bin/sing-box ' >/dev/null 2>&1 && /etc/init.d/sing-box restart >/dev/null 2>&1
		json_add_boolean ok "$([ "$rc" = 0 ] && echo 1 || echo 0)"
		json_add_string output "$out"
		json_dump
		;;
	esac
	;;
esac
