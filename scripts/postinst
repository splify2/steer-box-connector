#!/bin/sh
[ -n "${IPKG_INSTROOT}" ] && exit 0
# Правило forward в туннели (usr/share/nftables.d) fw4 подхватывает при перезагрузке.
[ -x /sbin/fw4 ] && fw4 -q reload 2>/dev/null
# Движок теперь ведёт коннектор своим экземпляром: служба steer — стоп и без автозапуска. Её
# спека (если есть) остаётся на месте; вернуть службу — /etc/init.d/steer enable && start.
if [ -x /etc/init.d/steer ]; then
	/etc/init.d/steer stop 2>/dev/null
	/etc/init.d/steer disable 2>/dev/null
	if [ -f /etc/steer/spec.json ] || [ -f /etc/steer/spec.yaml ]; then
		echo "steer-box-connector: служба steer выключена — движок ведёт коннектор; спека в /etc/steer сохранена"
	fi
fi
# Методы ubus страницы (rpcd: /usr/libexec/rpcd/steer-box) rpcd читает при старте — без
# перезапуска страница отвечает «Object not found». В фоне: установку могут запускать из самого
# rpcd, и перезапуск оборвал бы её ответ.
[ -x /etc/init.d/rpcd ] && ( sleep 2; /etc/init.d/rpcd restart ) >/dev/null 2>&1 &
# Запущенный sing-box (podkop или forkop уже работает) — перезапустить новой версией.
if [ -x /etc/init.d/sing-box ] && /etc/init.d/sing-box running 2>/dev/null; then
	/etc/init.d/sing-box restart 2>/dev/null
fi
exit 0
